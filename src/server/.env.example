# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Local: mongodb://localhost:27017/stockshop_ecommerce
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stockshop?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/stockshop_ecommerce

# JSON Web Token Secret
JWT_SECRET=super_secret_jwt_stockshop_key_2026_secure

# Environment Mode
NODE_ENV=production

